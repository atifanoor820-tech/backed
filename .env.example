# Copy to .env and adjust. Never commit .env.

# Folders Abbas may read/write (semicolon separated). Default: ./workspace
# ABBAS_WORKSPACES=D:\Projects;D:\Abbas 2\workspace

# Brain - Gemini plans tasks, writes replies, and locates things on screenshots.
# Key: https://aistudio.google.com/apikey
ABBAS_GEMINI_API_KEY=
ABBAS_GEMINI_MODEL=gemini-3.6-flash
ABBAS_GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# All free-tier. Tried in order on quota (429), overload (503) or timeout.
ABBAS_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
ABBAS_GEMINI_TIMEOUT_S=25

# Reflexes - Jev (TypeSafe AI) makes the fast typed decisions: which element, is it risky, did it work.
# Key: https://docs.typesafe.ai (early access). Pin a version: thresholds are tuned against it.
ABBAS_JEV_API_KEY=
ABBAS_JEV_MODEL=jev-1.14.0
ABBAS_JEV_MIN_CONFIDENCE=0.6
ABBAS_JEV_RISK_THRESHOLD=0.35
# Experimental: let Jev find click targets on screenshots ("box" questions)
ABBAS_JEV_IMAGES=false

# Hands
ABBAS_BROWSER_HEADLESS=false
# Drive installed Edge with a fresh profile (msedge | chrome), or leave empty for Playwright's Chromium
ABBAS_BROWSER_CHANNEL=msedge
ABBAS_SCREEN_ACTIONS=true

# Alternative brain: any OpenAI-compatible endpoint, used only when no Gemini key is set.
# ABBAS_LLM_BASE_URL=https://api.openai.com/v1
# ABBAS_LLM_API_KEY=
# ABBAS_LLM_MODEL=

# Apps that may be launched: name=executable;name=executable
ABBAS_ALLOWED_APPS=notepad=notepad.exe;calculator=calc.exe;explorer=explorer.exe

# Speech-to-text: whisper | elevenlabs
ABBAS_ASR_ENGINE=whisper
ABBAS_ASR_MODEL=base
ABBAS_ASR_DEVICE=cpu
ABBAS_ASR_COMPUTE_TYPE=int8
# Force a language (e.g. en, ur) or leave empty for auto-detect
ABBAS_ASR_LANGUAGE=
ABBAS_ASR_MIN_CONFIDENCE=0.55
ABBAS_MAX_RECORDING_S=30

# Text-to-speech: kokoro | piper | elevenlabs | none
ABBAS_TTS_ENGINE=kokoro
ABBAS_TTS_VOICE=am_michael
ABBAS_TTS_SPEED=1.0
# ABBAS_PIPER_MODEL_PATH=D:\voices\en_US-lessac-medium.onnx

# ElevenLabs (Cloud TTS and STT - supports free plan premade voices e.g. george, roger, sarah, alice, charlie)
ABBAS_ELEVENLABS_API_KEY=
ABBAS_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ABBAS_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

ABBAS_MAX_STEPS=8
ABBAS_TOOL_TIMEOUT_S=45

# Deploying (e.g. Vercel): the frontend's URL, so the browser may call this API. Comma separated.
# ABBAS_CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# Serverless hosts keep no files between requests: use Postgres (e.g. Neon) so data persists.
# ABBAS_DATABASE_URL=postgresql://user:pass@host/db
